# ============================================================
#  Configuración del portal de liquidaciones (domiciliarios)
# ============================================================

# Conexión a PostgreSQL (la misma base del aplicativo de escritorio).
# Opción A: variables individuales.
PGHOST=
PGPORT=5438
PGDATABASE=LIQUIDACIONESDB
PGUSER=
PGPASSWORD=

# Opción B (alternativa): una sola cadena.
# DATABASE_URL=postgresql://usuario:password@host:puerto/basededatos

# SSL de PostgreSQL. Pon "disable" para desarrollo local sin SSL.
# Déjalo vacío para SSL con certificado no verificado (VM/Azure).
PGSSL=

# SSO Suite Santacruz (login maestro por ticket)
SSO_ISSUER_URL=
SSO_SHARED_SECRET=
SSO_TIMEOUT_MS=7000

# SIGCOMPRO (solicitudes de almuerzo). URL base de la API, incluido /api.
# El secreto debe coincidir con SSO_SHARED_SECRET de SIGCOMPRO (si se omite, usa SSO_SHARED_SECRET).
SIGCOMPRO_API_URL=https://sigcompro.grupo-santacruz.com/api
SIGCOMPRO_SHARED_SECRET=
SIGCOMPRO_TIMEOUT_MS=8000
